<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiskSpaceAnalyzer.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Acento coral y fondo casi negro sobre la paleta oscura de Fluent. -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#F0563C"
                                       RegionColor="#09090B"
                                       ErrorText="#F87171" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://DiskSpaceAnalyzer.Desktop/Styles/Theme.axaml" />
    </Application.Styles>

</Application>
