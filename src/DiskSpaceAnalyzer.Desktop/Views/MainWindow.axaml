<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskSpaceAnalyzer.Desktop.ViewModels"
        x:Class="DiskSpaceAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Disk Space Analyzer"
        Width="900" Height="620" MinWidth="640" MinHeight="400">

    <Window.Resources>
        <!-- Iconos de Material Design Icons (Apache 2.0), 24x24. -->
        <StreamGeometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="FileIcon">M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Sincroniza el estado expandido del TreeViewItem con el ViewModel. -->
        <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">

        <!-- Barra superior: ruta y acciones -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding SelectedPath, Mode=TwoWay}"
                     PlaceholderText="Ruta de la carpeta a analizar"
                     IsEnabled="{Binding !IsScanning}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Examinar…"
                    Command="{Binding BrowseCommand}"
                    IsEnabled="{Binding !IsScanning}" />
            <Button Grid.Column="2" Content="Analizar" Classes="accent"
                    Command="{Binding ScanCommand}" />
            <Button Grid.Column="3" Content="Cancelar"
                    Command="{Binding ScanCancelCommand}"
                    IsVisible="{Binding IsScanning}" />
        </Grid>

        <!-- Barra inferior: estado -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
            <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
        </StackPanel>

        <!-- Resultado: encabezados + árbol -->
        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,110,150" Margin="28,0,8,4">
                <TextBlock Grid.Column="0" Text="Nombre" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Tamaño" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="% del contenedor" FontWeight="SemiBold" Margin="16,0,0,0" />
            </Grid>

            <TreeView Grid.Row="1" ItemsSource="{Binding RootNodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="*,110,150">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource FolderIcon}" Foreground="#E0A93B"
                                          Width="16" Height="16" IsVisible="{Binding IsDirectory}" />
                                <PathIcon Data="{StaticResource FileIcon}" Opacity="0.7"
                                          Width="16" Height="16" IsVisible="{Binding !IsDirectory}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="⚠" Foreground="OrangeRed" VerticalAlignment="Center"
                                           IsVisible="{Binding HasAccessErrors}"
                                           ToolTip.Tip="No se pudo leer todo el contenido de esta carpeta (acceso denegado)." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <Grid Grid.Column="2" ColumnDefinitions="*,56" Margin="16,0,0,0">
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="10"
                                             Value="{Binding Percent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

    </DockPanel>
</Window>
