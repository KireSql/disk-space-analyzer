<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskSpaceAnalyzer.Desktop.ViewModels"
        x:Class="DiskSpaceAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Disk Space Analyzer"
        Icon="avares://DiskSpaceAnalyzer.Desktop/Assets/icon.ico"
        Background="{DynamicResource BackgroundBrush}"
        Width="1000" Height="680" MinWidth="420" MinHeight="420">

    <Window.Resources>
        <!-- Iconos de Material Design Icons (Apache 2.0), 24x24. -->
        <StreamGeometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="FileIcon">M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z</StreamGeometry>
        <StreamGeometry x:Key="CheckCircleIcon">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Sincroniza el estado expandido del TreeViewItem con el ViewModel. -->
        <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- Anchos de las columnas de datos. Se comparten entre encabezado y filas para que queden alineadas. -->
        <Style Selector="TextBlock.size-cell">
            <Setter Property="Width" Value="96" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector=".percent-cell" x:SetterTargetType="Control">
            <Setter Property="Width" Value="190" />
        </Style>

        <!-- Fila del árbol. Las ubicaciones seguras de limpiar (clase "cleanup", enlazada al ViewModel) se
             tiñen de verde. El fondo va en estilos, no en el elemento, para que la clase pueda cambiarlo. -->
        <Style Selector="Border.node-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.node-row.cleanup">
            <Setter Property="Background" Value="#1A4ADE80" />
        </Style>

        <!-- Valores por defecto (pantalla ancha). Van en estilos y no en el elemento porque un valor local
             siempre gana a un estilo, y entonces las reglas responsive de abajo no podrían sobrescribirlos. -->
        <Style Selector="Border#Shell">
            <Setter Property="Padding" Value="32" />
        </Style>
        <Style Selector="UniformGrid#Tiles">
            <Setter Property="Columns" Value="4" />
        </Style>
        <Style Selector="Grid#Actions">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
        </Style>

        <!-- Responsive. La clase "compact" (< 900 px) y "narrow" (< 600 px) las gestiona MainWindow.axaml.cs. -->
        <Style Selector="Window.compact Border#Shell">
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Window.compact .percent-cell" x:SetterTargetType="Control">
            <Setter Property="Width" Value="130" />
        </Style>

        <Style Selector="Window.narrow Border#Shell">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Window.narrow TextBlock.title">
            <Setter Property="FontSize" Value="21" />
        </Style>
        <Style Selector="Window.narrow .percent-cell" x:SetterTargetType="Control">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.narrow UniformGrid#Tiles">
            <Setter Property="Columns" Value="2" />
        </Style>
        <Style Selector="Window.narrow Grid#Actions">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
    </Window.Styles>

    <Panel>

        <!-- Resplandor decorativo en la parte superior -->
        <Border Height="440" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="75%" RadiusY="100%">
                    <GradientStop Color="#40F0563C" Offset="0" />
                    <GradientStop Color="#00F0563C" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="Shell">
            <Grid MaxWidth="1280" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">

                <!-- Encabezado -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Classes="title" Text="Disk Space Analyzer" />
                    <TextBlock Classes="subtitle" Text="Descubre qué carpetas y archivos ocupan tu espacio." />
                </StackPanel>

                <!-- Bloque tipo terminal: ruta, estado y acciones -->
                <Border Grid.Row="1" Classes="card" Padding="20,16">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="›" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="terminal"
                                     Text="{Binding SelectedPath, Mode=TwoWay}"
                                     PlaceholderText="Ruta de la carpeta a analizar"
                                     IsEnabled="{Binding !IsScanning}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12">

                            <!-- Columna "*": el texto ocupa el ancho disponible y salta de línea en lugar de pisar los botones. -->
                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           IsVisible="{Binding HasSummary}" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid x:Name="Actions" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0" Classes="ghost" Content="Examinar…"
                                        Command="{Binding BrowseCommand}"
                                        IsEnabled="{Binding !IsScanning}" />
                                <Button Grid.Column="1" Classes="accent" Content="Analizar"
                                        Command="{Binding ScanCommand}" />
                                <Button Grid.Column="2" Classes="ghost" Content="Cancelar"
                                        Command="{Binding ScanCancelCommand}"
                                        IsVisible="{Binding IsScanning}" />
                            </Grid>
                        </Grid>

                        <ProgressBar Classes="bar" IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                    </StackPanel>
                </Border>

                <!-- Resumen: tarjetas de cifras y, si corresponde, aviso de espacio recuperable -->
                <StackPanel Grid.Row="2" Spacing="12" IsVisible="{Binding HasSummary}">

                <UniformGrid x:Name="Tiles" RowSpacing="12" ColumnSpacing="12">
                    <Border Classes="tile">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="TAMAÑO TOTAL" />
                            <TextBlock Classes="tile-value" Text="{Binding Summary.TotalSize}"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="ARCHIVOS" />
                            <TextBlock Classes="tile-value" Text="{Binding Summary.Files}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="CARPETAS" />
                            <TextBlock Classes="tile-value" Text="{Binding Summary.Folders}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="DURACIÓN" />
                            <TextBlock Classes="tile-value" Text="{Binding Summary.Elapsed}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Solo informa: la aplicación no borra nada. -->
                <Border Classes="callout" IsVisible="{Binding Summary.HasReclaimable}">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                        <PathIcon Grid.Column="0" Data="{StaticResource CheckCircleIcon}" Width="28" Height="28"
                                  Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="caption" Text="RECUPERABLE" />
                            <TextBlock Classes="tile-value" Text="{Binding Summary.ReclaimableSize}"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary.ReclaimableHeadline}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding Summary.ReclaimableDetails}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                </StackPanel>

                <!-- Resultado: encabezados + árbol -->
                <Border Grid.Row="3" Classes="card" Padding="8" ClipToBounds="True">
                    <Panel>

                        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding !ShowEmptyState}">

                            <!-- Mismas columnas y margen derecho que la plantilla de cada fila, para que queden alineadas. -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="34,8,18,8">
                                <TextBlock Grid.Column="0" Classes="caption" Text="NOMBRE" />
                                <TextBlock Grid.Column="1" Classes="caption size-cell" Text="TAMAÑO" />
                                <TextBlock Grid.Column="2" Classes="caption percent-cell" Text="% DEL CONTENEDOR"
                                           Margin="20,0,0,0" />
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}"
                                    Margin="0,0,0,4" />

                            <!-- Sin scroll horizontal: así el ancho de las filas se limita a la ventana y los
                                 nombres largos se recortan con "…" en lugar de empujar las columnas fuera de vista. -->
                            <TreeView Grid.Row="2" Background="Transparent" ItemsSource="{Binding RootNodes}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                                        <!-- El fondo (transparente por defecto, verde si es ubicación segura) viene de los
                                             estilos "node-row"; así toda la fila responde al clic derecho, no solo el texto. -->
                                        <Border Classes="node-row" Classes.cleanup="{Binding IsCleanupRoot}"
                                                Padding="6,5,16,5" ToolTip.Tip="{Binding CleanupTooltip}">

                                          <Grid ColumnDefinitions="*,Auto,Auto">

                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Abrir en el explorador de archivos"
                                                              Command="{Binding OpenInExplorerCommand}"
                                                              IsVisible="{Binding IsDirectory}" />
                                                    <MenuItem Header="Mostrar en el explorador de archivos"
                                                              Command="{Binding OpenInExplorerCommand}"
                                                              IsVisible="{Binding !IsDirectory}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <!-- Carpeta ámbar normal, o verde si es una ubicación segura de limpiar (o está dentro de una). -->
                                                <PathIcon Grid.Column="0" Data="{StaticResource FolderIcon}" Foreground="#F5B84B"
                                                          Width="16" Height="16" IsVisible="{Binding IsPlainDirectory}" />
                                                <PathIcon Grid.Column="0" Data="{StaticResource FolderIcon}"
                                                          Foreground="{DynamicResource SuccessBrush}"
                                                          Width="16" Height="16" IsVisible="{Binding IsCleanupDirectory}" />
                                                <PathIcon Grid.Column="0" Data="{StaticResource FileIcon}"
                                                          Foreground="{DynamicResource TextMutedBrush}"
                                                          Width="16" Height="16" IsVisible="{Binding !IsDirectory}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2" Classes="badge-safe" IsVisible="{Binding IsCleanupRoot}">
                                                    <TextBlock Text="LIMPIABLE" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="⚠" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           IsVisible="{Binding HasAccessErrors}"
                                                           ToolTip.Tip="No se pudo leer todo el contenido de esta carpeta." />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Classes="size-cell" Text="{Binding SizeText}"
                                                       VerticalAlignment="Center" />

                                            <!-- MinWidth="0" (en .bar): el ProgressBar de Fluent trae un ancho mínimo que desbordaba la celda. -->
                                            <Grid Grid.Column="2" Classes="percent-cell" ColumnDefinitions="*,56"
                                                  Margin="20,0,0,0" ClipToBounds="True">
                                                <ProgressBar Grid.Column="0" Classes="bar" Minimum="0" Maximum="100"
                                                             Value="{Binding Percent}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding PercentText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                          </Grid>
                                        </Border>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <!-- Estado vacío -->
                        <StackPanel IsVisible="{Binding ShowEmptyState}" Spacing="6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource FolderIcon}" Width="40" Height="40"
                                      Foreground="{DynamicResource BorderSubtleBrush}" />
                            <TextBlock Classes="muted" Text="Elige una carpeta para ver qué ocupa más espacio."
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                    </Panel>
                </Border>

            </Grid>
        </Border>

    </Panel>
</Window>
